# Server-only Supabase credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-secret-key
SUPABASE_DATABASE_PREFIX=ba_dev

# Optional dedicated HMAC secret for Brand Anything model upload claims.
# If omitted, the server derives claims from the Supabase server secret.
# MODEL_UPLOAD_SIGNING_SECRET=replace-with-at-least-32-random-bytes

# Canonical public origin used by Address fields, share copy, and metadata.
NEXT_PUBLIC_SITE_URL=https://brand-anything.vercel.app

# Browser-safe values used by Supabase Auth. The publishable key is intentionally public.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key

# Legacy projects can use this instead of SUPABASE_SECRET_KEY.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-key
