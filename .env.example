# Server-only Supabase credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-secret-key
SUPABASE_DATABASE_PREFIX=ba_dev

# Optional dedicated HMAC secret for Brand Anything model upload claims.
# If omitted, the server derives claims from the Supabase server secret.
# MODEL_UPLOAD_SIGNING_SECRET=replace-with-at-least-32-random-bytes

# Canonical public origin used by Address fields, share copy, and metadata.
NEXT_PUBLIC_SITE_URL=https://brand-anything.vercel.app

# Server-only Stripe Connect + Checkout credentials. Use test-mode values locally.
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-local-or-deployed-webhook-secret
# Optional local helper override. When omitted, the helper reuses the account
# already attached to the seeded homepage auction.
# STRIPE_SANDBOX_CONNECTED_ACCOUNT_ID=acct_your-sandbox-connected-account
# Production Connect events can use a second endpoint secret.
# STRIPE_CONNECT_WEBHOOK_SECRET=whsec_your-connect-webhook-secret

# Browser-safe values used by Supabase Auth. The publishable key is intentionally public.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key

# Local development only: use a real local Supabase session for a mock X identity.
# Never enable this for a hosted Supabase project or a production build.
# NEXT_PUBLIC_X_AUTH_DEV_MOCK=1

# Optional: used only when the local Supabase X provider block is enabled.
# X_OAUTH_CLIENT_ID=your-x-oauth-2-client-id
# X_OAUTH_CLIENT_SECRET=your-x-oauth-2-client-secret

# Optional one-time input for `npm run auction:bind-default -- --environment=dev`.
# Keep the generated value private and never commit it.
# DEFAULT_AUCTION_MANAGER_RECOVERY_CODE=ba_mgr_your-43-character-base64url-secret

# Legacy projects can use this instead of SUPABASE_SECRET_KEY.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-key
