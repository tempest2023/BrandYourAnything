# Server-only Supabase credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-secret-key
SUPABASE_DATABASE_PREFIX=ba_dev

# Development/Preview must use ba_dev + Stripe test mode.
# Production must use ba_prod + Stripe live mode. Mismatches fail closed.
# Outside Vercel, set APP_ENV=production for a production deployment.
STRIPE_SECRET_KEY=sk_test_replace-with-your-test-key
# Signing secret for a snapshot webhook with Connected accounts scope.
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_replace-with-your-endpoint-secret
# Optional separate platform snapshot webhook signing secret.
# STRIPE_WEBHOOK_SECRET=whsec_replace-with-your-platform-endpoint-secret
# Long random server-only bearer secret for payment reconciliation.
# CRON_SECRET=replace-with-at-least-32-random-bytes

# Optional HTTPS endpoint that receives payment recovery alert JSON when a
# reconciliation run reports failures or a backlog. Alerts are always logged.
# PAYMENT_ALERT_WEBHOOK_URL=https://hooks.example.com/brand-anything-alerts

# Optional dedicated HMAC secret for Brand Anything model upload claims.
# If omitted, the server derives claims from the Supabase server secret.
# MODEL_UPLOAD_SIGNING_SECRET=replace-with-at-least-32-random-bytes

# Canonical public origin used by Address fields, share copy, and metadata.
NEXT_PUBLIC_SITE_URL=https://brand-anything.vercel.app

# Browser-safe values used by Supabase Auth. The publishable key is intentionally public.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key

# Legacy projects can use this instead of SUPABASE_SECRET_KEY.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-key
